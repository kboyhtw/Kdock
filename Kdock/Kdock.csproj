<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Kdock</RootNamespace>
    <AssemblyName>Kdock</AssemblyName>
    <ApplicationIcon>Resources\kdock.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Kdock.Meeting\Kdock.Meeting.csproj" />
    <ApplicationConfig Remove="app.config" />
    <None Remove="app.config" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <Target Name="BundleSingleFile" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' AND '$(PublishSingleFileBuilding)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish" Properties="PublishSingleFileBuilding=true;Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;PublishDir=$(OutputPath);IncludeNativeLibrariesForSelfExtract=true;IncludeAllContentForSelfExtract=true;DebugType=embedded;CopyOutputSymbolsToPublishDirectory=false" />
    <ItemGroup>
      <LooseAppFile Include="$(OutputPath)Kdock.dll" />
      <LooseAppFile Include="$(OutputPath)Kdock.Meeting.dll" />
      <LooseAppFile Include="$(OutputPath)Kdock.pdb" />
      <LooseAppFile Include="$(OutputPath)Kdock.Meeting.pdb" />
      <LooseAppFile Include="$(OutputPath)Kdock.deps.json" />
      <LooseAppFile Include="$(OutputPath)Kdock.runtimeconfig.json" />
      <LooseAppFile Include="$(OutputPath)Kdock.dll.config" />
    </ItemGroup>
    <Delete Files="@(LooseAppFile)" TreatErrorsAsWarnings="true" />
  </Target>

</Project>
