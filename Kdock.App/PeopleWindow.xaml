<Window x:Class="Kdock.App.PeopleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="People"
        Width="1180"
        Height="740"
        MinWidth="920"
        MinHeight="580"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource SurfaceBrush}"
        WindowStartupLocation="CenterScreen">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="#2A3648" BorderThickness="1" CornerRadius="8" Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="14,14,0,0" Padding="18,0" MouseLeftButtonDown="HeaderDrag">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Close" Width="80" Click="CloseClick" Style="{StaticResource GhostButton}" Margin="0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="People" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PresenceText" Text="Offline" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Row="1" Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="292"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource SurfaceInsetBrush}" Padding="14" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="This PC" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding DisplayDeskId}" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,6"/>
                            <TextBlock x:Name="LocalEndpointText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
                            <Button Content="Copy ID" Click="CopyIdClick" Style="{StaticResource AccentButton}"/>
                            <Button Content="Second window on this PC" Click="SecondWindowClick"/>
                            <TextBlock Text="Search" Foreground="{StaticResource MutedTextBrush}" Margin="0,14,0,4" FontSize="11"/>
                            <TextBox x:Name="SearchBox" Height="34" VerticalContentAlignment="Center" ToolTip="Search people by name or desk ID" TextChanged="SearchChanged"/>
                            <TextBlock Text="Desk ID or LAN address" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,4" FontSize="11"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Connect" Click="NewChatClick" Margin="6,0,0,0" Style="{StaticResource AccentButton}"/>
                                <TextBox x:Name="NewChatBox" Height="34" VerticalContentAlignment="Center" ToolTip="10-digit desk ID, or a LAN address such as 192.168.1.25" KeyDown="NewChatKeyDown"/>
                            </DockPanel>
                            <TextBlock Text="Directory" FontWeight="SemiBold" Margin="0,16,0,6"/>
                        </StackPanel>
                        <ListBox x:Name="PeopleList" Grid.Row="1" ItemsSource="{Binding People}" SelectionChanged="PeopleSelectionChanged" Background="Transparent" BorderThickness="0" PreviewMouseRightButtonDown="PeopleRightClick" ContextMenuOpening="PeopleMenuOpening">
                            <ListBox.ContextMenu>
                                <ContextMenu Background="#1C2030" Foreground="White">
                                    <MenuItem Header="Add to favorites" Click="AddFavoriteMenuClick"/>
                                    <MenuItem Header="Remove from favorites" Click="RemoveFavoriteMenuClick"/>
                                    <MenuItem Header="Delete" Click="DeletePersonMenuClick"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{Binding Star}" Click="FavoriteClick" PreviewMouseLeftButtonDown="FavoritePreview" Tag="{Binding}" Style="{StaticResource GhostButton}" Padding="8,2" FontSize="14"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DeskId}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                            <TextBlock Text="{Binding Presence}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <TextBlock Text="Meeting server" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Save" Click="ServerLostFocus" Margin="6,0,0,0" Style="{StaticResource AccentButton}"/>
                                <TextBox x:Name="ServerBox" Height="32" TextChanged="ServerChanged" LostFocus="ServerLostFocus" KeyDown="ServerKeyDown" VerticalContentAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="ServerStatusText" Text="Not checked" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource SurfaceInsetBrush}" Padding="14" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Files" Click="FilesClick" Style="{StaticResource ToolbarButton}"/>
                                <Button Content="Watch" Click="WatchScreenClick" Style="{StaticResource ToolbarButton}"/>
                                <Button Content="Share" Click="ShareScreenClick" Style="{StaticResource ToolbarButton}"/>
                                <Button Content="Reconnect" Click="ReconnectClick" Style="{StaticResource ToolbarButton}"/>
                                <Button Content="Disconnect" Click="DisconnectClick" Style="{StaticResource ToolbarButton}" Margin="0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="ConversationTitle" Text="Select a person" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ConversationStatus" Text="No active session" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <ListBox x:Name="ConversationList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border MaxWidth="480" Padding="12,10" Margin="6,4" CornerRadius="12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                <Setter Property="Background" Value="#1C2430"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Sender}" Value="You">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="Background" Value="#16324A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Foreground="#7F8B9A" FontSize="10" Margin="10,0,0,0"/>
                                                <TextBlock Text="{Binding Sender}" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowText}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border Margin="0,6,0,0" Padding="8" CornerRadius="8" Background="#0B0E14" MouseLeftButtonUp="OpenAttachmentClick" Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAttachment}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <DockPanel>
                                                    <Image Source="{Binding FileIcon}" Width="32" Height="32" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <ProgressBar Height="4" Margin="0,6,0,0" Maximum="{Binding ProgressMax}" Value="{Binding FileProgress}">
                                                            <ProgressBar.Style>
                                                                <Style TargetType="ProgressBar">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSending}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ProgressBar.Style>
                                                        </ProgressBar>
                                                        <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="#8B97A8" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Request">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Content="Allow" Tag="{Binding}" Click="AllowMessageClick" Style="{StaticResource AccentButton}" Padding="10,4" Margin="0"/>
                                                <Button Content="Deny" Tag="{Binding}" Click="DenyMessageClick" Padding="10,4" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Row="2" Background="#121821" CornerRadius="12" Padding="8" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Attach" Click="AttachClick" Style="{StaticResource GhostButton}" Padding="10,6"/>
                                <Button x:Name="EmojiButton" Grid.Column="1" Content="😊" Click="EmojiClick" Style="{StaticResource GhostButton}" Padding="10,6"/>
                                <Popup x:Name="EmojiPopup" PlacementTarget="{Binding ElementName=EmojiButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
                                    <Border Background="#151922" BorderBrush="#2A3648" BorderThickness="1" CornerRadius="12" Padding="10">
                                        <WrapPanel x:Name="EmojiPanel" Width="276"/>
                                    </Border>
                                </Popup>
                                <TextBox x:Name="ComposerBox" Grid.Column="2" MinHeight="36" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" KeyDown="ComposerKeyDown"/>
                                <Button Grid.Column="3" Content="Send" Click="SendClick" Style="{StaticResource AccentButton}" Padding="16,8" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
