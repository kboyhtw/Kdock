<Window x:Class="Kdock.App.PeopleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="People"
        Icon="pack://application:,,,/Resources/kdock.ico"
        Width="1180"
        Height="740"
        MinWidth="920"
        MinHeight="580"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource SurfaceBrush}"
        WindowStartupLocation="CenterScreen">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource SurfaceRaisedBrush}" MouseLeftButtonDown="HeaderDrag">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="—" Click="MinimizeClick" Style="{StaticResource CaptionButton}" ToolTip="Minimize"/>
                        <Button Content="☐" Click="MaximizeClick" Style="{StaticResource CaptionButton}" ToolTip="Maximize"/>
                        <Button Content="✕" Click="CloseClick" Style="{StaticResource CaptionCloseButton}" ToolTip="Close"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="People" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PresenceText" Text="Offline" Style="{StaticResource CaptionLabel}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="This PC" Style="{StaticResource CaptionLabel}"/>
                            <DockPanel Margin="0,4,0,12">
                                <Button DockPanel.Dock="Right" Content="Copy ID" Click="CopyIdClick" Style="{StaticResource GhostButton}" Padding="10,4" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DisplayDeskId}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="LocalEndpointText" Style="{StaticResource CaptionLabel}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <TextBlock Text="Search" Style="{StaticResource CaptionLabel}" Margin="0,0,0,6"/>
                            <TextBox x:Name="SearchBox" Height="36" Tag="Name or desk ID" ToolTip="Filter this list by name or desk ID" TextChanged="SearchChanged"/>
                            <TextBlock Text="Connect to a PC" Style="{StaticResource CaptionLabel}" Margin="0,12,0,6"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Connect" Click="NewChatClick" Margin="8,0,0,0" Style="{StaticResource AccentButton}" Padding="14,7"/>
                                <TextBox x:Name="NewChatBox" Height="36" Tag="10-digit desk ID or 192.168.1.25" ToolTip="Enter a 10-digit desk ID, or a LAN address such as 192.168.1.25" KeyDown="NewChatKeyDown"/>
                            </DockPanel>
                            <Button Content="Second window on this PC" Click="SecondWindowClick" Margin="0,10,0,0"/>
                            <TextBlock Text="Chat" Style="{StaticResource SectionLabel}" Margin="0,18,0,4"/>
                        </StackPanel>
                        <ListBox x:Name="PeopleList" Grid.Row="1" Margin="0,0,0,8" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding People}" SelectionChanged="PeopleSelectionChanged" PreviewMouseRightButtonDown="PeopleRightClick" ContextMenuOpening="PeopleMenuOpening">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Add to favorites" Click="AddFavoriteMenuClick"/>
                                    <MenuItem Header="Remove from favorites" Click="RemoveFavoriteMenuClick"/>
                                    <MenuItem Header="Delete" Click="DeletePersonMenuClick"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Content="{Binding Star}" Click="FavoriteClick" PreviewMouseLeftButtonDown="FavoritePreview" Tag="{Binding}" Style="{StaticResource GhostButton}" Padding="6,2" FontSize="14" VerticalAlignment="Center"/>
                                        <Grid Width="40" Height="40" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Ellipse Fill="{DynamicResource AvatarBrush}"/>
                                            <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="White"/>
                                            <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="{DynamicResource SurfaceInsetBrush}" StrokeThickness="2">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#8A8886"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Presence}" Value="Online">
                                                                <Setter Property="Fill" Value="{DynamicResource OnlineBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Presence}" Value="InSession">
                                                                <Setter Property="Fill" Value="#4F9CF9"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding PresenceLabel}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}"/>
                                                <TextBlock Text=" · " FontSize="12" Foreground="{DynamicResource SubtleTextBrush}"/>
                                                <TextBlock Text="{Binding TrustLabel}" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#C8A335"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTrusted}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource OnlineBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <TextBlock Text="Meeting server" Style="{StaticResource CaptionLabel}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="ServerStatusText" Text="Not checked" Style="{StaticResource CaptionLabel}" TextWrapping="Wrap"/>
                            <Button Content="Open settings" Click="OpenSettingsClick" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" Padding="0">
                    <Grid x:Name="ConversationPane" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="20,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource SurfaceRaisedBrush}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Files" Click="FilesClick" Style="{StaticResource ToolbarButton}"/>
                                    <Button Content="Watch" Click="WatchScreenClick" Style="{StaticResource ToolbarButton}"/>
                                    <Button Content="Share" Click="ShareScreenClick" Style="{StaticResource ToolbarButton}"/>
                                    <Button Content="Reconnect" Click="ReconnectClick" Style="{StaticResource ToolbarButton}"/>
                                    <Button Content="Disconnect" Click="DisconnectClick" Style="{StaticResource ToolbarButton}" Margin="0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="ConversationTitle" Text="Select a person" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ConversationStatus" Text="No active session" Style="{StaticResource CaptionLabel}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ListBox x:Name="ConversationList" Grid.Row="1" Margin="16,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border MaxWidth="520" Padding="12,10" Margin="4,3" CornerRadius="12,12,12,4" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                <Setter Property="Background" Value="{DynamicResource TheirsBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                <Setter Property="CornerRadius" Value="4,12,12,12"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="Background" Value="{DynamicResource MineBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="CornerRadius" Value="12,4,12,12"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" Margin="10,0,0,0"/>
                                                <TextBlock Text="{Binding Sender}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowText}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border Margin="0,6,0,0" Padding="10" CornerRadius="8" Background="{DynamicResource SurfaceInsetBrush}" MouseLeftButtonUp="OpenAttachmentClick" Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAttachment}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <DockPanel>
                                                    <Image Source="{Binding FileIcon}" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <ProgressBar Height="4" Margin="0,8,0,0" Maximum="{Binding ProgressMax}" Value="{Binding FileProgress}">
                                                            <ProgressBar.Style>
                                                                <Style TargetType="ProgressBar">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSending}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ProgressBar.Style>
                                                        </ProgressBar>
                                                        <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Request">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Content="Allow" Tag="{Binding}" Click="AllowMessageClick" Style="{StaticResource AccentButton}" Padding="12,5"/>
                                                <Button Content="Deny" Tag="{Binding}" Click="DenyMessageClick" Padding="12,5" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Row="2" Padding="16,12" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                            <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="8" Padding="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Click="AttachClick" Style="{StaticResource GhostButton}" Padding="10,8" ToolTip="Attach a file">
                                        <TextBlock Text="&#xE723;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                    </Button>
                                    <Button x:Name="EmojiButton" Grid.Column="1" Content="😊" Click="EmojiClick" Style="{StaticResource GhostButton}" Padding="10,8"/>
                                    <Popup x:Name="EmojiPopup" PlacementTarget="{Binding ElementName=EmojiButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
                                        <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                                            <WrapPanel x:Name="EmojiPanel" Width="276"/>
                                        </Border>
                                    </Popup>
                                    <TextBox x:Name="ComposerBox" Grid.Column="2" MinHeight="36" Tag="Type a message" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" KeyDown="ComposerKeyDown"/>
                                    <Button Grid.Column="3" Content="Send" Click="SendClick" Style="{StaticResource AccentButton}" Padding="16,8" Margin="4"/>
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
