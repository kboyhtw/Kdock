<Window x:Class="Kdock.App.RemoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote screen"
        Icon="pack://application:,,,/Resources/kdock.ico"
        Width="1100"
        Height="700"
        MinWidth="720"
        MinHeight="480"
        Background="Black"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="WindowKeyDown"
        PreviewKeyUp="WindowKeyUp">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="ChatColumn" Width="0"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="PictureHost" Background="Black" MouseMove="PictureMouseMove" MouseEnter="PictureMouseEnter" MouseDown="PictureMouseDown" MouseUp="PictureMouseUp" MouseWheel="PictureWheel" MouseLeave="PictureMouseLeave" SizeChanged="PictureSizeChanged">
            <Image x:Name="ScreenImage" Stretch="Uniform" IsHitTestVisible="False"/>
            <Image x:Name="RemoteCursor" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed"/>            <Border x:Name="CommandBar" Cursor="Arrow" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="8" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Files" Click="FilesClick" Style="{StaticResource ToolbarButton}" Padding="10,5"/>
                    <Button Content="Chat" Click="ChatClick" Style="{StaticResource ToolbarButton}" Padding="10,5"/>
                    <Button Content="Full screen" x:Name="FullButton" Click="FullClick" Style="{StaticResource ToolbarButton}" Padding="10,5"/>
                    <Button x:Name="PinButton" Click="PinClick" Style="{StaticResource ToolbarButton}" Padding="8,5" ToolTip="Unpin toolbar">
                        <TextBlock x:Name="PinGlyph" Text="&#xE77A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                    </Button>
                    <TextBlock Text="Quality" VerticalAlignment="Center" Margin="10,0,8,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                    <ComboBox x:Name="QualityBox" Width="220" Height="34" SelectedIndex="2" SelectionChanged="QualityChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Stop" Click="StopClick" Style="{StaticResource AccentButton}" Padding="12,6" Margin="8,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Column="1" Background="{DynamicResource SurfaceInsetBrush}" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="Send" Click="ChatSendClick" Style="{StaticResource AccentButton}" Margin="6,0,0,0" Padding="14,7"/>
                    <TextBox x:Name="ChatBox" MinHeight="32" Tag="Type a message"/>
                </DockPanel>
                <ListBox x:Name="ChatList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border MaxWidth="260" Padding="10,8" Margin="0,4" CornerRadius="12" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Background" Value="{DynamicResource TheirsBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Background" Value="{DynamicResource MineBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding Sender}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowText}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border Margin="0,4,0,0" Padding="8" CornerRadius="8" Background="{DynamicResource SurfaceInsetBrush}" MouseLeftButtonUp="OpenAttachmentClick" Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAttachment}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <Image Source="{Binding FileIcon}" Width="28" Height="28" Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <ProgressBar Height="4" Margin="0,6,0,0" Maximum="{Binding ProgressMax}" Value="{Binding FileProgress}">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSending}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>
                                                <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
