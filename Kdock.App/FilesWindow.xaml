<Window x:Class="Kdock.App.FilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Files"
        Width="980"
        Height="640"
        MinWidth="760"
        MinHeight="440"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource SurfaceBrush}"
        PreviewKeyDown="WindowPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="HeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#151922"/>
            <Setter Property="Foreground" Value="#F5F7FA"/>
            <Setter Property="BorderBrush" Value="#243041"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Background" Value="#1C2030"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="#2A3648" BorderThickness="1" CornerRadius="14" Margin="8">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="14,14,0,0" Padding="14,10" MouseLeftButtonDown="HeaderDrag">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Width="32" Height="28" Padding="0" Margin="4,0,0,0" Click="CloseClick" Style="{StaticResource GhostButton}" ToolTip="Close"/>
                    <Button DockPanel.Dock="Right" Content="—" Width="32" Height="28" Padding="0" Margin="0" Click="MinimizeClick" Style="{StaticResource GhostButton}" ToolTip="Minimize"/>
                    <TextBlock Text="Files" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <DockPanel Margin="14">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="2,10,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Copy stages the file. The transfer starts when you paste it in File Explorer on this PC."/>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Back" Click="BackClick" Margin="0,0,6,0" Padding="12,6"/>
            <Button Grid.Column="1" Content="Up" Click="UpClick" Margin="0,0,6,0" Padding="12,6"/>
            <TextBox x:Name="AddressBox" Grid.Column="2" Height="32" VerticalContentAlignment="Center" KeyDown="AddressKeyDown" Margin="0,0,6,0"/>
            <Button Grid.Column="3" Content="Go" Click="GoClick" Margin="0" Padding="12,6"/>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="List" Click="ListClick" Margin="0,0,6,0" Padding="12,6"/>
                <Button Content="Icons" Click="IconsClick" Margin="0,0,16,0" Padding="12,6"/>
                <Button Content="New folder" Click="NewFolderClick" Margin="0,0,6,0" Padding="12,6"/>
                <Button Content="Copy" Click="CopyClick" Margin="0,0,6,0" Padding="12,6"/>
                <Button Content="Cut" Click="CutClick" Margin="0,0,6,0" Padding="12,6"/>
                <Button Content="Paste" Click="PasteClick" Margin="0,0,6,0" Padding="12,6"/>
                <Button Content="Delete" Click="DeleteClick" Margin="0" Padding="12,6"/>
            </StackPanel>
        </Grid>
        <ListView x:Name="DetailList" SizeChanged="DetailSizeChanged" Background="{StaticResource SurfaceInsetBrush}" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource TextBrush}" MouseDoubleClick="FileDoubleClick" SelectionMode="Extended" PreviewMouseRightButtonDown="SelectOnRightClick" ContextMenuOpening="MenuOpening">
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource HeaderStyle}">
                    <GridViewColumn Header="Name" Width="420">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Date modified" Width="170" DisplayMemberBinding="{Binding ModifiedText}"/>
                    <GridViewColumn Header="Type" Width="140" DisplayMemberBinding="{Binding Type}"/>
                    <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding SizeText}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <ListBox x:Name="IconList" Visibility="Collapsed" Background="{StaticResource SurfaceInsetBrush}" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource TextBrush}" MouseDoubleClick="FileDoubleClick" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseRightButtonDown="SelectOnRightClick" ContextMenuOpening="MenuOpening">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="96" Margin="8" HorizontalAlignment="Center">
                        <Image Source="{Binding Icon}" Width="48" Height="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </DockPanel>
        </DockPanel>
    </Border>
</Window>
