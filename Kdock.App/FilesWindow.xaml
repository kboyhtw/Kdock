<Window x:Class="Kdock.App.FilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Files"
        Icon="pack://application:,,,/Resources/kdock.ico"
        Width="980"
        Height="640"
        MinWidth="760"
        MinHeight="440"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="{DynamicResource SurfaceBrush}"
        PreviewKeyDown="WindowPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="HeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceRaisedBrush}" Padding="4,0,0,0" MouseLeftButtonDown="HeaderDrag">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="—" Click="MinimizeClick" Style="{StaticResource CaptionButton}" ToolTip="Minimize"/>
                        <Button x:Name="MaxButton" Content="☐" Click="MaximizeClick" Style="{StaticResource CaptionButton}" ToolTip="Maximize"/>
                        <Button Content="✕" Click="CloseClick" Style="{StaticResource CaptionCloseButton}" ToolTip="Close"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Files" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="16,0,16,12" Foreground="{DynamicResource SubtleTextBrush}" Text="Copy stages the file. The transfer starts when you paste it in File Explorer on this PC."/>
            <Border DockPanel.Dock="Top" Padding="12,10" Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Back" Click="BackClick" Margin="0,0,6,0" Padding="12,6"/>
                        <Button Grid.Column="1" Content="Up" Click="UpClick" Margin="0,0,8,0" Padding="12,6"/>
                        <TextBox x:Name="AddressBox" Grid.Column="2" Height="34" Tag="Folder path" KeyDown="AddressKeyDown" Margin="0,0,8,0"/>
                        <Button Grid.Column="3" Content="Go" Click="GoClick" Style="{StaticResource AccentButton}" Padding="14,6"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="List" Click="ListClick" Style="{StaticResource ToolbarButton}"/>
                        <Button Content="Icons" Click="IconsClick" Style="{StaticResource ToolbarButton}" Margin="0,0,16,0"/>
                        <Button Content="New folder" Click="NewFolderClick" Style="{StaticResource ToolbarButton}"/>
                        <Button Content="Copy" Click="CopyClick" Style="{StaticResource ToolbarButton}"/>
                        <Button Content="Cut" Click="CutClick" Style="{StaticResource ToolbarButton}"/>
                        <Button Content="Paste" Click="PasteClick" Style="{StaticResource ToolbarButton}"/>
                        <Button Content="Delete" Click="DeleteClick" Style="{StaticResource ToolbarButton}" Margin="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Grid Margin="8">
            <ListView x:Name="DetailList" SizeChanged="DetailSizeChanged" Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextBrush}" MouseDoubleClick="FileDoubleClick" SelectionMode="Extended" PreviewMouseRightButtonDown="SelectOnRightClick" ContextMenuOpening="MenuOpening">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource HeaderStyle}">
                        <GridViewColumn Header="Name" Width="420">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Date modified" Width="170" DisplayMemberBinding="{Binding ModifiedText}"/>
                        <GridViewColumn Header="Type" Width="140" DisplayMemberBinding="{Binding Type}"/>
                        <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding SizeText}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <ListBox x:Name="IconList" Visibility="Collapsed" Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextBrush}" MouseDoubleClick="FileDoubleClick" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseRightButtonDown="SelectOnRightClick" ContextMenuOpening="MenuOpening">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="96" Margin="8" HorizontalAlignment="Center">
                            <Image Source="{Binding Icon}" Width="48" Height="48" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Grid>
        </DockPanel>
    </Border>
</Window>
