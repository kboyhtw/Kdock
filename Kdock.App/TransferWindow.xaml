<Window x:Class="Kdock.App.TransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copying"
        Icon="pack://application:,,,/Resources/kdock.ico"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        MouseLeftButtonDown="DragWindow">
    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="8">
        <StackPanel>
            <DockPanel Margin="0,0,0,6" LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="✕" Click="CloseClick" Style="{StaticResource CaptionCloseButton}" Width="28" Height="28" ToolTip="Close"/>
                <TextBlock Text="Copying" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <ItemsControl x:Name="Items">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,8,0,0">
                            <DockPanel>
                                <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="Cancel" Tag="{Binding Id}" Click="CancelClick" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ProgressBar Height="4" Margin="0,8,0,0" Maximum="{Binding Total}" Value="{Binding Done}"/>
                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
