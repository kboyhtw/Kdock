<Window x:Class="Kdock.App.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kdock"
        Icon="pack://application:,,,/Resources/kdock.ico"
        MinWidth="280"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        Background="{DynamicResource SurfaceBrush}"
        Loaded="OnLoaded"
        SizeChanged="OnSizeChanged">
    <Window.Resources>
        <Style x:Key="DockTile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DockTool" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="DockIcon" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="PowerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="6,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid>
    <Border x:Name="DockChrome" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftSlot" Width="Auto"/>
                <ColumnDefinition Width="268"/>
                <ColumnDefinition x:Name="RightSlot" Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SidePanel" Grid.Column="2" Width="380" Visibility="Collapsed" Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="14" CornerRadius="0,12,12,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="✕" Width="28" Height="28" Padding="0" Margin="0" Click="CloseSideClick" Style="{StaticResource GhostButton}"/>
                        <TextBlock x:Name="SideTitle" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel x:Name="AppsPanel" Visibility="Collapsed">
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="Add" Click="AddAppClick" Style="{StaticResource AccentButton}" Margin="6,0,0,0" Padding="12,6"/>
                            <TextBlock Text="Drop a file or shortcut here. Stored in this PC’s Kdock Apps folder." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListBox x:Name="AppsList" AllowDrop="True" Drop="AppsDrop" DragOver="AppsDragOver" MouseDoubleClick="AppOpenClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <Grid x:Name="NotesPanel" Visibility="Collapsed">
                        <DockPanel x:Name="NotesListView">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="New" Click="NewNoteClick" Style="{StaticResource AccentButton}" Padding="14,6" Margin="8,0,0,0"/>
                                <TextBox x:Name="NotesSearch" Height="34" Tag="Search notes" TextChanged="NotesSearchChanged"/>
                            </DockPanel>
                            <TextBlock x:Name="NotesEmpty" DockPanel.Dock="Bottom" Text="No notes yet. Press New to write one." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="4,10,4,0" Visibility="Collapsed"/>
                            <ListBox x:Name="NotesList" MinHeight="280" BorderThickness="0" Background="Transparent" MouseDoubleClick="NoteOpenClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open" Click="OpenNoteMenuClick"/>
                                        <MenuItem Header="Rename" Click="RenameNoteMenuClick"/>
                                        <MenuItem Header="Delete" Click="DeleteNoteClick"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Card" Background="{DynamicResource SurfaceCardBrush}" CornerRadius="10" Padding="12,10" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Preview}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding WhenText}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Top" Margin="8,2,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                        <DockPanel x:Name="NotesEditView" Visibility="Collapsed">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Left" Content="←" Click="NotesBackClick" Style="{StaticResource GhostButton}" Width="36" Padding="0" ToolTip="Back to notes"/>
                                <Button DockPanel.Dock="Right" Content="Delete" Click="DeleteNoteClick" Style="{StaticResource GhostButton}" Padding="10,4" Margin="4,0,0,0" Foreground="{DynamicResource DangerBrush}"/>
                                <TextBox x:Name="NoteTitleBox" Height="34" Tag="Note title" LostFocus="NoteTitleLostFocus" KeyDown="NoteTitleKeyDown" Margin="8,0,0,0"/>
                            </DockPanel>
                            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="6,4" Margin="0,0,0,8">
                                <WrapPanel>
                                    <Button Content="B" FontWeight="Bold" Click="BoldClick" Style="{StaticResource DockTool}" Padding="10,4" ToolTip="Bold"/>
                                    <Button Content="I" FontStyle="Italic" Click="ItalicClick" Style="{StaticResource DockTool}" Padding="10,4" ToolTip="Italic"/>
                                    <Button Content="U" Click="UnderlineClick" Style="{StaticResource DockTool}" Padding="10,4" ToolTip="Underline"/>
                                    <Button Content="S" Click="StrikeClick" Style="{StaticResource DockTool}" Padding="10,4" ToolTip="Strikethrough"/>
                                    <Button Content="≡" Click="BulletClick" Style="{StaticResource DockTool}" Padding="10,4" ToolTip="Bullets"/>
                                    <Button Content="Search" Click="SearchClick" Style="{StaticResource DockTool}" Padding="10,4"/>
                                    <Button Content="Speak" Click="NarrateClick" Style="{StaticResource DockTool}" Padding="10,4"/>
                                </WrapPanel>
                            </Border>
                            <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MinHeight="260">
                                <RichTextBox x:Name="NotesEditor" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" LostFocus="NotesLostFocus" BorderThickness="0" Padding="12,10" Background="Transparent" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"/>
                            </Border>
                        </DockPanel>
                    </Grid>
                    <DockPanel x:Name="PcsPanel" Visibility="Collapsed">
                        <Button DockPanel.Dock="Top" Content="Open Inbox" Click="OpenInboxClick" Style="{StaticResource AccentButton}" Margin="0,0,0,10" Padding="12,8"/>
                        <TextBlock DockPanel.Dock="Top" Text="Named PCs — drop a file to send it there. Progress stays until it finishes." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,8"/>
                        <ListBox x:Name="PcList" DockPanel.Dock="Top" Height="128" AllowDrop="True" PreviewDragOver="PcDragOver" Drop="PcDrop" MouseDoubleClick="PcOpenClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <TextBlock Text="Drop files in Explorer while Kdock is running." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,8"/>
                            <Button Content="Desktop folder" Click="PcDesktopClick" Style="{StaticResource AccentButton}" Padding="10,6" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Arrived on this PC" FontWeight="SemiBold" Margin="0,10,0,6"/>
                        <ListBox x:Name="ArrivalList" MouseDoubleClick="ArrivalOpenClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}">
                                            <Run Text="{Binding From, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding WhenText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <DockPanel x:Name="ClipPanel" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Bottom" Text="Click an item to copy it again." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,8,0,0"/>
                        <ListBox x:Name="ClipList" MouseDoubleClick="ClipPasteClick" MouseLeftButtonUp="ClipPasteClick"/>
                    </DockPanel>
                    <DockPanel x:Name="ToolsPanel" Visibility="Collapsed">
                        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="10" Padding="8" Margin="0,10,0,0">
                            <UniformGrid Columns="4">
                                <Button Click="PowerLockClick" Style="{StaticResource PowerButton}" ToolTip="Lock">
                                    <StackPanel>
                                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="Lock" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="SleepClick" Style="{StaticResource PowerButton}" ToolTip="Sleep">
                                    <StackPanel>
                                        <TextBlock Text="&#xE708;" FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center" Foreground="#60CDFF"/>
                                        <TextBlock Text="Sleep" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="RestartClick" Style="{StaticResource PowerButton}" ToolTip="Restart">
                                    <StackPanel>
                                        <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center" Foreground="#F7D070"/>
                                        <TextBlock Text="Restart" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="ShutdownClick" Style="{StaticResource PowerButton}" ToolTip="Shut down">
                                    <StackPanel>
                                        <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center" Foreground="#E74856"/>
                                        <TextBlock Text="Shut down" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </Border>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Add tool" Click="AddToolClick" Style="{StaticResource AccentButton}" Padding="12,6"/>
                            <TextBlock Text="This PC" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </DockPanel>
                        <ListBox x:Name="ToolsList" MouseLeftButtonUp="ToolOpenClick">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Remove" Click="RemoveToolClick"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="86" Margin="2" CornerRadius="8" Background="{DynamicResource SurfaceCardBrush}" Padding="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="1" Margin="12,10,12,12">
                <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="4,4,4,4" Margin="0,0,0,10" MouseLeftButtonDown="HeaderDrag" Cursor="SizeAll">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Click="ExitClick" Style="{StaticResource CaptionCloseButton}" Width="36" Height="32" ToolTip="Exit Kdock"/>
                        <Button DockPanel.Dock="Right" Click="CollapseDockClick" Style="{StaticResource DockIcon}" Width="32" Height="32" ToolTip="Hide dock while sharing">
                            <TextBlock x:Name="CollapseGlyph" Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Click="SettingsClick" Style="{StaticResource DockIcon}" Width="32" Height="32" Foreground="{DynamicResource TextBrush}" ToolTip="Settings">
                            <TextBlock Text="&#xE115;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextBrush}"/>
                        </Button>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Kdock" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="Drag to move" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBox x:Name="RunBox" DockPanel.Dock="Bottom" Height="34" Tag="Type a program, path, or search"
                         Margin="0,10,0,0"
                         ToolTip="Type a program, path, or search, then press Enter"
                         KeyDown="RunKeyDown"/>
                <TextBlock DockPanel.Dock="Bottom" Text="Run or search" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="2,8,0,0"/>

                <StackPanel>
                    <TextBlock Text="{Binding ClockText}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding MachineName}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    <DockPanel Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Content="Copy" Click="CopyIdClick" Style="{StaticResource GhostButton}" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DisplayDeskId}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SubtleTextBrush}" Margin="7,0,0,0" FontSize="12"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdateText" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" FontSize="11" Visibility="Collapsed" Margin="0,0,0,6"/>

                    <UniformGrid Columns="2" Margin="0,6,0,0">
                        <Grid>
                            <Button Style="{StaticResource DockTile}" Click="PeopleClick" Margin="3">
                                <StackPanel>
                                    <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="PeopleButton" Text="People" FontWeight="SemiBold"/>
                                    <TextBlock Text="Chat and remote" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                            <Border x:Name="PeopleBadge" Width="20" Height="20" CornerRadius="10" Background="#E5484D" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,0,0" Visibility="Collapsed" IsHitTestVisible="False">
                                <TextBlock x:Name="PeopleBadgeText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </Grid>
                        <Button Style="{StaticResource DockTile}" Click="PcsClick">
                            <StackPanel>
                                <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Inbox" FontWeight="SemiBold"/>
                                <TextBlock Text="Send files" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DockTile}" Click="AppsClick">
                            <StackPanel>
                                <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Apps" FontWeight="SemiBold"/>
                                <TextBlock Text="Shortcuts" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DockTile}" Click="NotesClick">
                            <StackPanel>
                                <TextBlock Text="&#xE70B;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Notes" FontWeight="SemiBold"/>
                                <TextBlock Text="Quick capture" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DockTile}" Click="ClipClick">
                            <StackPanel>
                                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Clipboard" FontWeight="SemiBold"/>
                                <TextBlock Text="Recent copies" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DockTile}" Click="ToolsClick">
                            <StackPanel>
                                <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Tools" FontWeight="SemiBold"/>
                                <TextBlock Text="This PC" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
    <Button x:Name="PeekButton" Visibility="Collapsed" Width="28" Height="80" Padding="0" Click="ExpandDockClick"
            ToolTip="Show Kdock" Style="{StaticResource AccentButton}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="PeekGlyph" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White"/>
    </Button>
    </Grid>
</Window>
