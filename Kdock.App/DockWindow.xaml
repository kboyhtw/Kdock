<Window x:Class="Kdock.App.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kdock"
        MinWidth="248"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        Background="{StaticResource SurfaceBrush}"
        Loaded="OnLoaded"
        SizeChanged="OnSizeChanged">
    <Window.Resources>
        <Style x:Key="DockTile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="#151C26"/>
        </Style>
        <Style x:Key="DockTool" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="DockIcon" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="#2A3648" BorderThickness="1" CornerRadius="14" Margin="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftSlot" Width="Auto"/>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition x:Name="RightSlot" Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SidePanel" Grid.Column="2" Width="320" Visibility="Collapsed" Background="{StaticResource SurfaceInsetBrush}" BorderBrush="#2A3648" BorderThickness="1,0,0,0" Padding="12" CornerRadius="0,14,14,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="✕" Width="28" Height="28" Padding="0" Margin="0" Click="CloseSideClick" Style="{StaticResource GhostButton}"/>
                        <TextBlock x:Name="SideTitle" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel x:Name="AppsPanel" Visibility="Collapsed">
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="Add" Click="AddAppClick" Style="{StaticResource AccentButton}" Margin="6,0,0,0" Padding="12,6"/>
                            <TextBlock Text="Drop a file or shortcut here. Stored in this PC’s Kdock Apps folder." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListBox x:Name="AppsList" AllowDrop="True" Drop="AppsDrop" DragOver="AppsDragOver" MouseDoubleClick="AppOpenClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <DockPanel x:Name="NotesPanel" Visibility="Collapsed">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button Content="B" FontWeight="Bold" Click="BoldClick" Style="{StaticResource DockTool}" Padding="8,4"/>
                            <Button Content="I" FontStyle="Italic" Click="ItalicClick" Style="{StaticResource DockTool}" Padding="8,4"/>
                            <Button Content="U" Click="UnderlineClick" Style="{StaticResource DockTool}" Padding="8,4"/>
                            <Button Content="S" Click="StrikeClick" Style="{StaticResource DockTool}" Padding="8,4"/>
                            <Button Content="List" Click="BulletClick" Style="{StaticResource DockTool}" Padding="8,4"/>
                            <Button Content="Search" Click="SearchClick" Style="{StaticResource DockTool}" Padding="8,4"/>
                            <Button Content="Speak" Click="NarrateClick" Style="{StaticResource DockTool}" Padding="8,4"/>
                        </WrapPanel>
                        <RichTextBox x:Name="NotesEditor" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" LostFocus="NotesLostFocus" MinHeight="220" Background="#0B0E14" Foreground="#F1F4F8" CaretBrush="#F1F4F8" BorderBrush="#243041" BorderThickness="1" Padding="8"/>
                    </DockPanel>
                    <DockPanel x:Name="PcsPanel" Visibility="Collapsed">
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="Desktop folder" Click="PcDesktopClick" Style="{StaticResource AccentButton}" Margin="6,0,0,0" Padding="10,6"/>
                            <Button DockPanel.Dock="Right" Content="Open inbox" Click="OpenInboxClick" Padding="10,6" Margin="0"/>
                            <TextBlock Text="Drop files on a PC. They land in that PC’s Kdock Inbox. Desktop folder: drop files in Explorer." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListBox x:Name="PcList" AllowDrop="True" PreviewDragOver="PcDragOver" Drop="PcDrop" MouseDoubleClick="PcOpenClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <DockPanel x:Name="ClipPanel" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Bottom" Text="Click an item to copy it again." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,8,0,0"/>
                        <ListBox x:Name="ClipList" MouseDoubleClick="ClipPasteClick" MouseLeftButtonUp="ClipPasteClick"/>
                    </DockPanel>
                    <WrapPanel x:Name="ToolsPanel" Visibility="Collapsed">
                        <Button Content="Explorer" Click="ExplorerClick" Style="{StaticResource DockTool}"/>
                        <Button Content="Terminal" Click="TerminalClick" Style="{StaticResource DockTool}"/>
                        <Button Content="Task Manager" Click="TaskMgrClick" Style="{StaticResource DockTool}"/>
                        <Button Content="Calculator" Click="CalcClick" Style="{StaticResource DockTool}"/>
                        <Button Content="Notepad" Click="NotepadClick" Style="{StaticResource DockTool}"/>
                        <Button Content="Settings" Click="SettingsClick" Style="{StaticResource DockTool}"/>
                        <Button Content="Display" Click="DisplayClick" Style="{StaticResource DockTool}"/>
                        <Button Content="Network" Click="NetworkClick" Style="{StaticResource DockTool}"/>
                        <Button Content="Recycle Bin" Click="RecycleClick" Style="{StaticResource DockTool}"/>
                        <Button Content="Snip" Click="SnipClick" Style="{StaticResource DockTool}"/>
                        <Button Content="Sleep" Click="SleepClick" Style="{StaticResource DockTool}"/>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="1" Margin="12,10,12,12">
                <Border DockPanel.Dock="Top" Background="#121821" CornerRadius="10" Padding="10,8" Margin="0,0,0,10" MouseLeftButtonDown="HeaderDrag" Cursor="SizeAll">
                    <DockPanel>
                        <Button x:Name="PinButton" DockPanel.Dock="Right" Content="📌" Click="PinClick" Style="{StaticResource DockIcon}" ToolTip="Keep on top"/>
                        <Button DockPanel.Dock="Right" Content="✕" Click="ExitClick" Style="{StaticResource DockIcon}" ToolTip="Exit Kdock"/>
                        <StackPanel>
                            <TextBlock Text="KDOCK" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Drag to move" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBox x:Name="RunBox" DockPanel.Dock="Bottom" Height="34" VerticalContentAlignment="Center" Margin="0,10,0,0"
                         ToolTip="Type a program, path, or search, then press Enter"
                         KeyDown="RunKeyDown"/>
                <TextBlock DockPanel.Dock="Bottom" Text="Run or search" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="2,8,0,0"/>

                <StackPanel>
                    <TextBlock Text="{Binding ClockText}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding MachineName}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Copy" Click="CopyIdClick" Style="{StaticResource GhostButton}" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DisplayDeskId}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" Margin="7,0,0,0" FontSize="12"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdateText" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" FontSize="11" Visibility="Collapsed" Margin="0,0,0,6"/>

                    <UniformGrid Columns="2" Margin="0,6,0,0">
                        <Grid>
                            <Button Style="{StaticResource DockTile}" Click="PeopleClick" Margin="3">
                                <StackPanel>
                                    <TextBlock x:Name="PeopleButton" Text="People" FontWeight="SemiBold"/>
                                    <TextBlock Text="Chat and remote" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>
                            </Button>
                            <Border x:Name="PeopleBadge" Width="20" Height="20" CornerRadius="10" Background="#E5484D" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,0,0" Visibility="Collapsed" IsHitTestVisible="False">
                                <TextBlock x:Name="PeopleBadgeText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </Grid>
                        <Button Style="{StaticResource DockTile}" Click="PcsClick">
                            <StackPanel>
                                <TextBlock Text="PCs" FontWeight="SemiBold"/>
                                <TextBlock Text="Drop files to a PC" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DockTile}" Click="AppsClick">
                            <StackPanel>
                                <TextBlock Text="Apps" FontWeight="SemiBold"/>
                                <TextBlock Text="Pinned shortcuts" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DockTile}" Click="NotesClick">
                            <StackPanel>
                                <TextBlock Text="Notes" FontWeight="SemiBold"/>
                                <TextBlock Text="Quick capture" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DockTile}" Click="ClipClick">
                            <StackPanel>
                                <TextBlock Text="Clipboard" FontWeight="SemiBold"/>
                                <TextBlock Text="Recent copies" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DockTile}" Click="ToolsClick">
                            <StackPanel>
                                <TextBlock Text="Tools" FontWeight="SemiBold"/>
                                <TextBlock Text="This PC utilities" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DockTile}" Click="LockClick">
                            <StackPanel>
                                <TextBlock Text="Lock" FontWeight="SemiBold"/>
                                <TextBlock Text="Secure this PC" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
